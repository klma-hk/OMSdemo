<UserControl x:Class="WpfApp1.OMSTextbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1"
             Focusable="False"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:views="clr-namespace:WpfApp1.ViewModels">
    <TextBox Name="InnerTextBox"
             Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Text, UpdateSourceTrigger=PropertyChanged}"
             GotKeyboardFocus="InnerTextBox_GotKeyboardFocus"
             PreviewMouseLeftButtonDown="InnerTextBox_PreviewMouseLeftButtonDown"
             PreviewKeyDown="InnerTextBox_PreviewKeyDown" />
</UserControl>
